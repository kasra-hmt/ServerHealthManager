$domainInfo = New-Label 'Domain: -' 18 12 500 22 $font
$timeInfo = New-Label 'Last Check: -' 18 38 500 22 $font
$policyInfo = New-Label 'Auto-Fix: Date/Time + KMS only' 600 24 470 25 $fontBold
$policyInfo.TextAlign = 'MiddleRight'
